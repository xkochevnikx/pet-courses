{
  "name": "bot",
  "description": "A blank template to get started with Payload",
  "version": "1.0.0",
  "main": "dist/server.js",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env PAYLOAD_CONFIG_PATH=src/admin/payload.config.ts nodemon",
    "build:payload": "cross-env PAYLOAD_CONFIG_PATH=src/admin/payload.config.ts payload build",
    "build:server": "tsc",
    "build": "yarn copyfiles && yarn build:payload && yarn build:server",
    "serve": "cross-env PAYLOAD_CONFIG_PATH=dist/admin/payload.config.js NODE_ENV=production node dist/server.js",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png}\" dist/",
    "generate:types": "cross-env PAYLOAD_CONFIG_PATH=src/admin/payload.config.ts payload generate:types",
    "generate:graphQLSchema": "cross-env PAYLOAD_CONFIG_PATH=src/admin/payload.config.ts payload generate:graphQLSchema",
    "payload": "cross-env PAYLOAD_CONFIG_PATH=src/admin/payload.config.ts payload"
  },
  "dependencies": {
    "@payloadcms/bundler-webpack": "1.0.7",
    "@payloadcms/db-mongodb": "1.7.5",
    "@payloadcms/plugin-cloud": "3.0.2",
    "@payloadcms/richtext-slate": "1.5.2",
    "cross-env": "7.0.3",
    "dotenv": "8.6.0",
    "express": "4.22.2",
    "jsonwebtoken": "9.0.3",
    "payload": "2.32.3",
    "pino": "9.14.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "socks-proxy-agent": "10.1.0",
    "telegraf": "4.16.3",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "9.0.10",
    "copyfiles": "2.4.1",
    "nodemon": "2.0.22",
    "ts-node": "9.1.1",
    "typescript": "4.9.5"
  }
}
